# Supabase — projeto GSBC
# Copie este arquivo para .env.local e preencha com as credenciais do projeto Supabase.
# NUNCA commitar .env.local ou chaves reais.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — uso exclusivo em contexto server-side (jobs, webhooks, scripts administrativos).
# Nunca expor ao cliente. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (usada em redirects de auth, links de convite, etc.)
# Precisa bater com o site_url/additional_redirect_urls do Supabase Auth
# (supabase/config.toml em dev local; Authentication > URL Configuration
# no dashboard em produção) — senão o Supabase Auth descarta o redirectTo
# do convite/magic link (STG-05, Portal de Regularização Empresarial) e
# volta pra URL raiz sem completar a sessão.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP para e-mails transacionais (notificações de cobrança). Em dev local,
# aponta para o Inbucket do `supabase start` (SMTP_HOST=127.0.0.1,
# SMTP_PORT=54325) — os e-mails ficam visíveis em http://127.0.0.1:54324,
# nunca saem de verdade. Em produção, preencher com um provedor SMTP real.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=

# Inteligência cadastral — Fase 2 (enriquecimento web via LeadCNPJ,
# https://leadcnpj.com.br). Opcional: sem essa chave, a consulta usa só
# a Receita Federal (Fase 1). Gerar em Configurações → API no painel
# LeadCNPJ (tem trial de 7 dias sem cartão).
LEADCNPJ_API_KEY=

# Motor de cobrança (STG-02, Rodada 19) — protege /api/cron/collection-engine.
# A Vercel injeta automaticamente `Authorization: Bearer $CRON_SECRET` nas
# chamadas do Vercel Cron (ver vercel.json); sem essa variável configurada,
# o endpoint recusa qualquer chamada. Gere um valor aleatório longo.
CRON_SECRET=
